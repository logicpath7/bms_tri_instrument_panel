// secrets.h.example
//
// Copy this file to secrets.h (same folder) and fill in your real WiFi
// credentials. secrets.h itself is gitignored and must never be
// committed — only this .example file, with placeholder values, belongs
// in version control.

#ifndef SECRETS_H
#define SECRETS_H

const char* WIFI_SSID     = "YOUR_SSID_HERE";
const char* WIFI_PASSWORD = "YOUR_PASSWORD_HERE";
const char* LOCAL_URL     = "YOUR_URL_HERE";


#endif
